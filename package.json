{
  "name": "test11",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4.9.1",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "destinations": true,
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "[production]": {
          "credentials": {
            "destination": "API_BUSINESS_PARTNER"
          }
        }
      },
      "API_SUPPLIERINVOICE_PROCESS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_SUPPLIERINVOICE_PROCESS_SRV",
        "[production]": {
          "credentials": {
            "destination": "API_SUPPLIERINVOICE_PROCESS_SRV"
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      }
    }
  }
}
