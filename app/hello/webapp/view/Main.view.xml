<mvc:View
  controllerName="hello.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  xmlns="sap.m"
  displayBlock="true"
  height="100%">
  <App>
    <Page title="Supplier Check">
      <VBox>
        <Panel headerText="Is the supplier set up correctly?">
          <VBox width="20rem">
            <Label text="Supplier number" labelFor="supplier" />
            <Input id="supplier" placeholder="e.g. 17300001" submit=".onCheckSupplier" />
            <Button text="Check" type="Emphasized" press=".onCheckSupplier" class="sapUiSmallMarginTop" />
          </VBox>
          <VBox id="supplierResult" visible="{= !!${supplier>/supplier} }" class="sapUiMediumMarginTop">
            <Title text="{supplier>/name} ({supplier>/supplier})" level="H2" />
            <ObjectStatus
              id="supplierOverall"
              text="{= ${supplier>/ok} ? 'Set up correctly' : ${supplier>/failed} + ' issue(s) found' }"
              state="{= ${supplier>/ok} ? 'Success' : 'Error' }"
              inverted="true"
              class="sapUiSmallMarginTop" />
          </VBox>
        </Panel>
        <IconTabBar
          id="tabs"
          selectedKey="checks"
          visible="{= !!${supplier>/supplier} }"
          expandable="false"
          class="sapUiResponsiveContentPadding">
          <items>
            <IconTabFilter
              key="checks"
              text="Checks"
              icon="sap-icon://checklist-item"
              count="{= ${supplier>/failed} > 0 ? ${supplier>/failed} : '' }"
              iconColor="{= ${supplier>/ok} ? 'Positive' : 'Negative' }">
              <Table id="checks" items="{supplier>/checks}">
                <columns>
                  <Column width="12rem"><Text text="Check" /></Column>
                  <Column width="8rem"><Text text="Result" /></Column>
                  <Column><Text text="Details" /></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{supplier>check}" />
                      <ObjectStatus
                        text="{= ${supplier>ok} ? 'OK' : 'Failed' }"
                        state="{= ${supplier>ok} ? 'Success' : 'Error' }"
                        icon="{= ${supplier>ok} ? 'sap-icon://sys-enter-2' : 'sap-icon://error' }" />
                      <Text text="{supplier>details}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </IconTabFilter>
            <IconTabFilter
              key="details"
              text="Details"
              icon="sap-icon://supplier">
              <VBox id="details">
                <form:SimpleForm
                  id="detailsForm"
                  editable="false"
                  layout="ColumnLayout"
                  columnsM="2"
                  columnsL="2"
                  columnsXL="2">
                  <form:content>
                    <core:Title text="General" />
                    <Label text="Business partner" />
                    <Text text="{= ${supplier>/details/businessPartner} || '–' }" />
                    <Label text="Account group" />
                    <Text text="{= ${supplier>/details/accountGroup} || '–' }" />
                    <Label text="Created on" />
                    <Text text="{= ${supplier>/details/createdOn} || '–' }" />
                    <Label text="Created by" />
                    <Text text="{= ${supplier>/details/createdBy} || '–' }" />
                    <core:Title text="Contact" />
                    <Label text="Address" />
                    <Text text="{= ${supplier>/details/address} || '–' }" />
                    <Label text="Phone" />
                    <Text text="{= ${supplier>/details/phone} || '–' }" />
                    <Label text="Email" />
                    <Text text="{= ${supplier>/details/email} || '–' }" />
                  </form:content>
                </form:SimpleForm>

                <Table
                  id="companyCodes"
                  items="{supplier>/details/companyCodes}"
                  noDataText="Not created in any company code"
                  class="sapUiMediumMarginTop">
                  <headerToolbar>
                    <OverflowToolbar>
                      <Title text="Company codes" level="H3" />
                    </OverflowToolbar>
                  </headerToolbar>
                  <columns>
                    <Column><Text text="Company code" /></Column>
                    <Column><Text text="Reconciliation account" /></Column>
                    <Column><Text text="Payment terms" /></Column>
                    <Column><Text text="Payment methods" /></Column>
                    <Column><Text text="Accounting clerk" /></Column>
                    <Column><Text text="Payment block" /></Column>
                  </columns>
                  <items>
                    <ColumnListItem>
                      <cells>
                        <ObjectIdentifier title="{supplier>companyCode}" />
                        <Text text="{= ${supplier>reconciliationAccount} || '–' }" />
                        <Text text="{= ${supplier>paymentTerms} || '–' }" />
                        <Text text="{= ${supplier>paymentMethods} || '–' }" />
                        <Text text="{= ${supplier>accountingClerk} || '–' }" />
                        <ObjectStatus
                          text="{= ${supplier>paymentBlock} ? 'Blocked (' + ${supplier>paymentBlock} + ')' : 'None' }"
                          state="{= ${supplier>paymentBlock} ? 'Error' : 'Success' }" />
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>

                <Table
                  id="purchasingOrgs"
                  items="{supplier>/details/purchasingOrgs}"
                  noDataText="Not created in any purchasing organization"
                  class="sapUiMediumMarginTop">
                  <headerToolbar>
                    <OverflowToolbar>
                      <Title text="Purchasing organizations" level="H3" />
                    </OverflowToolbar>
                  </headerToolbar>
                  <columns>
                    <Column><Text text="Purchasing organization" /></Column>
                    <Column><Text text="Order currency" /></Column>
                    <Column><Text text="Payment terms" /></Column>
                  </columns>
                  <items>
                    <ColumnListItem>
                      <cells>
                        <ObjectIdentifier title="{supplier>purchasingOrganization}" />
                        <Text text="{= ${supplier>currency} || '–' }" />
                        <Text text="{= ${supplier>paymentTerms} || '–' }" />
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>

                <Table
                  id="banks"
                  items="{supplier>/details/banks}"
                  noDataText="No bank accounts"
                  class="sapUiMediumMarginTop">
                  <headerToolbar>
                    <OverflowToolbar>
                      <Title text="Bank accounts" level="H3" />
                    </OverflowToolbar>
                  </headerToolbar>
                  <columns>
                    <Column><Text text="Bank" /></Column>
                    <Column><Text text="Country" /></Column>
                    <Column><Text text="Bank number" /></Column>
                    <Column><Text text="Account" /></Column>
                    <Column><Text text="IBAN" /></Column>
                    <Column><Text text="SWIFT" /></Column>
                  </columns>
                  <items>
                    <ColumnListItem>
                      <cells>
                        <ObjectIdentifier title="{= ${supplier>bankName} || '–' }" />
                        <Text text="{= ${supplier>bankCountry} || '–' }" />
                        <Text text="{= ${supplier>bankNumber} || '–' }" />
                        <Text text="{= ${supplier>account} || '–' }" />
                        <Text text="{= ${supplier>iban} || '–' }" />
                        <Text text="{= ${supplier>swift} || '–' }" />
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </VBox>
            </IconTabFilter>
            <IconTabFilter
              key="invoices"
              text="Invoices"
              icon="sap-icon://receipt"
              count="{= ${supplier>/invoices} ? ${supplier>/invoices}.length : '' }">
              <MessageStrip
                text="{supplier>/invoicesError}"
                type="Warning"
                showIcon="true"
                visible="{= !!${supplier>/invoicesError} }"
                class="sapUiSmallMarginBottom" />
              <Table id="invoices" items="{supplier>/invoices}" noDataText="No invoices found">
                <columns>
                  <Column><Text text="Invoice" /></Column>
                  <Column><Text text="Supplier reference" /></Column>
                  <Column><Text text="Company code" /></Column>
                  <Column><Text text="Posting date" /></Column>
                  <Column hAlign="End"><Text text="Amount" /></Column>
                  <Column><Text text="Payment status" /></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{supplier>invoice}/{supplier>fiscalYear}" />
                      <Text text="{supplier>reference}" />
                      <Text text="{supplier>companyCode}" />
                      <Text text="{supplier>postingDate}" />
                      <ObjectNumber number="{supplier>amount}" unit="{supplier>currency}" />
                      <ObjectStatus
                        text="{supplier>status}"
                        state="{= ${supplier>paymentBlocked} ? 'Error' : 'Success' }" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </IconTabFilter>
          </items>
        </IconTabBar>
      </VBox>
    </Page>
  </App>
</mvc:View>
