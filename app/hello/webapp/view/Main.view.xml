<mvc:View
  controllerName="hello.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true"
  height="100%">
  <App>
    <Page title="Supplier Check">
      <VBox>
        <Panel headerText="Is the supplier set up correctly?">
          <VBox width="20rem">
            <Label text="Supplier number" labelFor="supplier" />
            <Input id="supplier" placeholder="e.g. 17300001" submit=".onCheckSupplier" />
            <Button text="Check" type="Emphasized" press=".onCheckSupplier" class="sapUiSmallMarginTop" />
          </VBox>
          <VBox id="supplierResult" visible="{= !!${supplier>/supplier} }" class="sapUiMediumMarginTop">
            <Title text="{supplier>/name} ({supplier>/supplier})" level="H2" />
            <ObjectStatus
              id="supplierOverall"
              text="{= ${supplier>/ok} ? 'Set up correctly' : ${supplier>/failed} + ' issue(s) found' }"
              state="{= ${supplier>/ok} ? 'Success' : 'Error' }"
              inverted="true"
              class="sapUiSmallMarginTopBottom" />
            <Table id="checks" items="{supplier>/checks}">
              <columns>
                <Column width="12rem"><Text text="Check" /></Column>
                <Column width="8rem"><Text text="Result" /></Column>
                <Column><Text text="Details" /></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{supplier>check}" />
                    <ObjectStatus
                      text="{= ${supplier>ok} ? 'OK' : 'Failed' }"
                      state="{= ${supplier>ok} ? 'Success' : 'Error' }"
                      icon="{= ${supplier>ok} ? 'sap-icon://sys-enter-2' : 'sap-icon://error' }" />
                    <Text text="{supplier>details}" />
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </VBox>
        </Panel>
        <Panel headerText="Supplier details" visible="{= !!${supplier>/supplier} }">
          <VBox id="details" items="{supplier>/details}">
            <items>
              <ObjectAttribute title="{supplier>label}" text="{supplier>value}" class="sapUiTinyMarginBottom" />
            </items>
          </VBox>
        </Panel>
        <Panel headerText="Recent supplier invoices" visible="{= !!${supplier>/supplier} }">
          <MessageStrip
            text="{supplier>/invoicesError}"
            type="Warning"
            showIcon="true"
            visible="{= !!${supplier>/invoicesError} }"
            class="sapUiSmallMarginBottom" />
          <Table id="invoices" items="{supplier>/invoices}" noDataText="No invoices found">
            <columns>
              <Column><Text text="Invoice" /></Column>
              <Column><Text text="Supplier reference" /></Column>
              <Column><Text text="Company code" /></Column>
              <Column><Text text="Posting date" /></Column>
              <Column hAlign="End"><Text text="Amount" /></Column>
              <Column><Text text="Payment status" /></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{supplier>invoice}/{supplier>fiscalYear}" />
                  <Text text="{supplier>reference}" />
                  <Text text="{supplier>companyCode}" />
                  <Text text="{supplier>postingDate}" />
                  <ObjectNumber number="{supplier>amount}" unit="{supplier>currency}" />
                  <ObjectStatus
                    text="{supplier>status}"
                    state="{= ${supplier>paymentBlocked} ? 'Error' : 'Success' }" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </Panel>
      </VBox>
    </Page>
  </App>
</mvc:View>
